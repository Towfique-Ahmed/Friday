# SQLite works out of the box for local development — no setup required.
DATABASE_URL="file:./dev.db"

# For production, point this at a PostgreSQL instance instead (see docker-compose.yml)
# and change the `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
# DATABASE_URL="postgresql://friday:friday@localhost:5432/friday?schema=public"

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-in-production"
